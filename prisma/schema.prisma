// HotelOS Ultra — multi-tenant schema. Every business model carries tenantId;
// all application queries MUST filter by it (see src/lib/tenant.ts).
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Connection URL lives in prisma.config.ts (Prisma 7 removed datasource.url
// from the schema file — see prisma.config.ts and src/lib/prisma.ts).
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum KnowledgeDocType {
  TEXT
  PDF
  IMAGE
  BROCHURE
  FAQ
}

enum LeadStatus {
  NEW
  INTERESTED
  FOLLOW_UP
  BOOKED
  CLOSED
}

enum LeadSource {
  DIRECT // messaged in organically
  META_AD // arrived via a Click-to-WhatsApp ad referral
  COLD_IMPORT // owner-uploaded old number
}

enum BookingStatus {
  NONE
  PENDING
  CONFIRMED
  CANCELLED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  LOCATION
  TEMPLATE
  // An outbound WhatsApp interactive (reply-button) message we sent, or an
  // inbound tap on one — see Message.interactiveId for the tapped option's
  // machine-readable id (the tapped label text is still just `content`).
  INTERACTIVE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  REPLIED
}

enum FollowUpAction {
  REMINDER
  OFFER
  PACKAGE
  LAST
}

enum ScheduledFollowUpStatus {
  PENDING
  SENT
  CANCELLED
  // Due, but outside the WhatsApp 24h free-form window with no approved
  // template configured on the rule — sending would violate WhatsApp policy.
  SKIPPED
}

enum CampaignMessageType {
  TEXT
  IMAGE
  TEMPLATE
}

enum MetaTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  REPLIED
  INTERESTED
  BOOKED
  FAILED
  CANCELLED
}

enum CampaignSendPacing {
  ALL_AT_ONCE
  SPACED
}

// ─── Tenant & auth ──────────────────────────────────────────────────────

model Tenant {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String             @unique
  // Per-tenant WhatsApp Business Cloud API credentials — never a single
  // global number. whatsappAccessToken is encrypted at rest (see
  // src/lib/crypto.ts); this column stores ciphertext, not the raw value.
  // The webhook's app secret / verify token are deliberately NOT here: one
  // Meta App (and therefore one webhook URL, one app secret, one verify
  // token — see WHATSAPP_APP_SECRET / WHATSAPP_VERIFY_TOKEN in .env)
  // fronts every tenant's WABA; only phone_number_id/access_token differ
  // per hotel. Inbound payloads are routed to a tenant by phone_number_id.
  whatsappPhoneNumberId String?            @unique
  whatsappWabaId        String?
  whatsappAccessToken   String?
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  planFeeInPaise        Int                @default(100000)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users              User[]
  hotelProfile       HotelProfile?
  rooms              Room[]
  knowledgeDocs      KnowledgeDoc[]
  knowledgeChunks    KnowledgeChunk[]
  faqs               Faq[]
  offers             Offer[]
  contacts           Contact[]
  messages           Message[]
  followUpRules      FollowUpRule[]
  scheduledFollowUps ScheduledFollowUp[]
  campaigns          Campaign[]
  staffNotifications StaffNotification[]
  metaTemplates      MetaTemplate[]
  bookings           Booking[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedContacts Contact[] @relation("ContactAssignee")

  @@unique([tenantId, email])
}

/**
 * The platform operator's own login — belongs to no tenant, sits outside
 * the multi-tenant model entirely. Manages every hotel from /admin: create
 * new hotels, view cross-tenant stats, change subscription status. Kept as
 * a fully separate table/session (see src/lib/auth/admin-session.ts, the
 * "hotelos_admin_session" cookie) rather than a flag on User, since "runs
 * the SaaS" and "staffs one particular hotel" are different roles that
 * shouldn't share a login surface or a JWT shape.
 */
model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Hotel content / knowledge base ────────────────────────────────────

model HotelProfile {
  tenantId              String   @id
  name                  String
  address               String?
  googleMapsUrl         String?
  lat                   Float?
  lng                   Float?
  checkInTime           String?
  checkOutTime          String?
  wifiInfo              String?
  parkingInfo           String?
  restaurantInfo        String?
  cancellationPolicy    String?
  refundPolicy          String?
  nearbyAttractions     String?
  businessHours         String?
  aiSystemPrompt        String?  @db.Text
  aiAgentName           String   @default("Anushka")
  // Optional owner override for the "IVR-4821"-style booking reference code
  // prefix — auto-derived from the hotel name when unset (see
  // src/lib/booking/reference-code.ts).
  bookingCodePrefix     String?
  // The published WhatsApp Flow id for the one-tap booking form (real room
  // dropdown + native date-range calendar) — see
  // src/lib/whatsapp/flows/booking-flow.ts. Null until the one-time setup
  // script creates and publishes a Flow for this tenant; the "Book a room"
  // tap falls back to today's step-by-step buttons whenever this is unset.
  whatsappBookingFlowId String?
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Room {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String
  description String?
  price       Int
  capacity    Int
  amenities   String[]
  imageUrls   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
}

model KnowledgeDoc {
  id        String           @id @default(cuid())
  tenantId  String
  title     String
  type      KnowledgeDocType
  sourceUrl String?
  rawText   String?          @db.Text
  createdAt DateTime         @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
}

// `embedding` is `Unsupported` because Prisma has no first-class vector
// type — it's declared here so migrations create the column, but reads/
// writes of the vector value itself go through $queryRaw/$executeRaw (see
// src/lib/ai/rag.ts). Dimension (1024) matches Voyage AI's voyage-3 model,
// the default embedding provider — see src/lib/ai/embeddings.ts.
model KnowledgeChunk {
  id        String                       @id @default(cuid())
  tenantId  String
  docId     String
  content   String                       @db.Text
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doc    KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([docId])
}

model Faq {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Offer {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?
  discount    String?
  // Short code a guest can type in chat (e.g. "FLAT100") to have it matched
  // and snapshotted onto their Booking at confirmation time — see
  // src/lib/booking/offer-match.ts. Optional: nothing breaks if unset, the
  // guest's booking just won't have a matched offer recorded.
  code        String?
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
}

// ─── CRM ────────────────────────────────────────────────────────────────

model Contact {
  id              String        @id @default(cuid())
  tenantId        String
  name            String?
  phone           String
  whatsappNumber  String
  createdAt       DateTime      @default(now())
  lastMessage     String?
  lastInboundAt   DateTime?
  leadStatus      LeadStatus    @default(NEW)
  bookingStatus   BookingStatus @default(NONE)
  aiSummary       String?       @db.Text
  // Set true the moment staff sends a manual reply — pauses the AI for this
  // contact until a staff member flips it back off (see M3 in the spec).
  aiPaused        Boolean       @default(false)
  // When the pause started, so a stale one can expire.
  //
  // Sending a manual reply sets aiPaused, which is right while a human is
  // actually in the conversation — but nothing ever cleared it, so one
  // friendly message from staff silenced Anushka for that guest forever.
  // Found in production with 5 of 8 contacts dead: guests were messaging
  // "Hi" and getting nothing at all, for a day.
  //
  // A pause older than AI_PAUSE_EXPIRY_HOURS is treated as stale and lifted
  // on the guest's next message. Staff who genuinely want the bot off can
  // pause again from the CRM, and that tap re-stamps this.
  aiPausedAt      DateTime?
  // A manually scheduled reminder (calendar date/time picker in the CRM) —
  // separate from the automated FollowUpRule ladder. When followUpDate
  // comes due, the worker's reminder sweep creates a REMINDER-type
  // StaffNotification prompting staff to personally reach out, then clears
  // both fields — it's a nudge to a human, not an automatic WhatsApp send,
  // since a one-off manual follow-up usually needs personal context.
  followUpDate    DateTime?
  followUpNote    String?
  notes           String?       @db.Text
  // CRM tags (free-form labels, e.g. "VIP", "Corporate") and read-state /
  // ownership for the team inbox view.
  tags            String[]      @default([])
  lastReadAt      DateTime?
  assignedToId    String?
  // Where this contact came from — set once at creation, never overwritten
  // by later messages. sourceDetail is the ad headline (META_AD) or an
  // import note (COLD_IMPORT); ctwaClid is Meta's click id, kept for future
  // ad-platform reporting but not acted on yet.
  leadSource      LeadSource    @default(DIRECT)
  sourceDetail    String?
  ctwaClid        String?
  // Set when the guest clicks a "Stop promos" quick-reply button or texts
  // STOP/UNSUBSCRIBE — a required opt-out mechanism under WhatsApp's
  // Business Messaging Policy. Suppresses campaign broadcasts and follow-up
  // nudges, but not the core AI concierge — a guest who opts out of
  // promotions should still get help if they message in on their own.
  optedOutAt      DateTime?
  // The room/dates Anushka and the guest have converged on but not yet
  // confirmed — a denormalized "current negotiation state," same pattern as
  // aiSummary/bookingStatus above. Read at the "Confirm booking" tap to run
  // a real-time availability check and populate the Booking row; cleared on
  // a date conflict so the next answer is treated fresh. Not a booking
  // itself — see the Booking model for that.
  pendingRoomId   String?
  pendingCheckIn  DateTime?
  pendingCheckOut DateTime?
  // Party size, captured the turn the guest first states it (see
  // src/lib/booking/guest-count.ts). Stored rather than re-derived from the
  // transcript on every turn because the AI pipeline only ever loads the
  // last 12 messages — in any longer conversation the message where the
  // guest answered "how many people?" scrolls out of that window and the
  // answer is silently lost, so they get asked all over again. Persisting it
  // is the only fix that survives a long chat.
  pendingGuestCount Int?
  // The language this guest chats in — "en" | "hi" | "te". Set when they tap
  // the language picker, and inferred when they write in Devanagari or
  // Telugu script. Stored rather than re-read from the transcript for the
  // same reason the slots above are: the AI pipeline only loads the last 12
  // messages, so the turn where they chose is lost in any longer chat. It
  // also has to outlive the transcript entirely, because every button title
  // is rendered in this language — the choice governs the whole UI, not just
  // one reply.
  language        String?
  updatedAt       DateTime      @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo         User?               @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages           Message[]
  scheduledFollowUps ScheduledFollowUp[]
  campaignRecipients CampaignRecipient[]
  staffNotifications StaffNotification[]
  bookings           Booking[]

  @@unique([tenantId, whatsappNumber])
  @@index([tenantId, leadStatus])
  @@index([tenantId, leadSource])
  @@index([assignedToId])
}

// A completed WhatsApp-negotiated booking — separate from Contact (which is
// a durable per-phone-number record a repeat guest reuses across stays;
// single-booking fields there would overwrite history on a second booking).
// Contact.bookingStatus mirrors the latest Booking.status for this contact.
model Booking {
  id               String        @id @default(cuid())
  tenantId         String
  contactId        String
  // e.g. "IVR-4821" — see src/lib/booking/reference-code.ts. The guest
  // quotes this at the counter; staff looks it up to confirm it's a real
  // Anushka-negotiated booking and see the agreed room/dates/price.
  referenceCode    String
  status           BookingStatus @default(PENDING)
  // Snapshot of Contact.aiSummary at the moment of booking — kept fresh by
  // summarizeConversation() after every AI turn, so this is a free,
  // always-current "what the guest wants and where things stand" record.
  summary          String?       @db.Text
  // Room/Offer snapshots, not live references only — those rows can change
  // or be deleted later, and a booking should always reflect what was
  // actually agreed at the time, not whatever the room/offer looks like now.
  offerId          String?
  offerSnapshot    String?
  roomId           String?
  roomNameSnapshot String?
  // The actual stay dates, captured at confirmation time — used for
  // real-time availability checking (see src/lib/booking/availability.ts).
  // Nullable: a legacy booking made before this field existed, or one
  // confirmed without structured dates ever being captured, simply doesn't
  // block a room for any date range.
  checkIn          DateTime?
  checkOut         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([tenantId, referenceCode])
  @@index([tenantId, contactId])
  @@index([roomId, checkIn, checkOut])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  contactId         String
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  content           String?          @db.Text
  mediaUrl          String?
  // Meta's own media id. Object storage is optional here and unset in
  // production, so for an attachment this id is the only handle on the actual
  // bytes — /api/media/[id] streams them back through us so the CRM can show
  // them. mediaUrl stays preferred when storage IS configured, since Meta's
  // media ids expire after a few days.
  mediaId           String?
  mediaMimeType     String?
  mediaFilename     String?
  // Why a send failed, taken straight from the status webhook's errors[].
  // Meta accepts a doomed request with a 200 and a message id, then reports
  // the real outcome asynchronously — so without this the CRM can only show
  // THAT something failed, never that it was the 24-hour window, which is the
  // one cause staff can actually do something about.
  errorCode         Int?
  errorTitle        String?
  // Machine-readable id from an interactive button/list tap (button_reply.id
  // / list_reply.id) — set on inbound INTERACTIVE messages only. The tapped
  // label text still lives in `content` via the existing fallback.
  interactiveId     String?
  // WhatsApp's wamid — unique across the whole platform, used to dedupe
  // webhook retries idempotently. Nullable (draft/failed-before-send rows).
  whatsappMessageId String?          @unique
  status            MessageStatus    @default(SENT)
  // Set only for OUT messages a staff member typed manually (vs. Anushka) —
  // lets the CRM show "replied by Priya".
  senderUserId      String?
  createdAt         DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, createdAt])
}

// ESCALATION: the AI couldn't handle something confidently (existing default
// behavior, unchanged). BOOKING: a contact's leadStatus just moved to BOOKED
// — rendered as a more insistent popup + flashing tab title on the
// dashboard, not just the passive notification list. REMINDER: a manually
// scheduled follow-up (Contact.followUpDate) has come due.
enum StaffNotificationType {
  ESCALATION
  BOOKING
  REMINDER
}

model StaffNotification {
  id        String                @id @default(cuid())
  tenantId  String
  contactId String
  reason    String
  type      StaffNotificationType @default(ESCALATION)
  resolved  Boolean               @default(false)
  createdAt DateTime              @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolved])
}

// ─── Follow-up automation ───────────────────────────────────────────────

model FollowUpRule {
  id           String         @id @default(cuid())
  tenantId     String
  order        Int
  delayMinutes Int
  action       FollowUpAction
  // Legacy free-text template name — fallback path for a template approved
  // directly in Meta Business Manager and never imported into this app.
  templateName String?
  messageBody  String?
  active       Boolean        @default(true)
  // When true, each time this rule fires (sent or skipped — see sweep.ts)
  // it re-arms itself 24h later instead of stopping, until the guest
  // replies (cancels all PENDING rows) or the lead is BOOKED/CLOSED.
  repeatDaily  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  metaTemplateId         String?
  metaTemplate           MetaTemplate? @relation(fields: [metaTemplateId], references: [id], onDelete: SetNull)
  templateVariableValues Json?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduledFollowUps ScheduledFollowUp[]

  @@index([tenantId])
}

model ScheduledFollowUp {
  id        String                  @id @default(cuid())
  tenantId  String
  contactId String
  ruleId    String
  runAt     DateTime
  status    ScheduledFollowUpStatus @default(PENDING)
  createdAt DateTime                @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rule    FollowUpRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, runAt])
}

// ─── Broadcast campaigns ────────────────────────────────────────────────

model Campaign {
  id           String              @id @default(cuid())
  tenantId     String
  name         String
  type         String
  messageType  CampaignMessageType
  // Legacy free-text template name — still the fallback path for a
  // template approved directly in Meta Business Manager and never
  // imported into this app. When metaTemplateId is set, that takes
  // precedence and this is derived from it server-side, not client-trusted.
  templateName String?
  body         String?
  mediaUrl     String?
  createdAt    DateTime            @default(now())
  sentAt       DateTime?
  // Set to send this campaign automatically at a future date/time instead
  // of immediately — the worker's campaign-schedule sweep (see
  // sweepDueCampaigns in send.ts) picks it up once scheduledAt has passed
  // and sentAt is still null, exactly like the follow-up sweep does for
  // ScheduledFollowUp rows.
  scheduledAt  DateTime?

  // ALL_AT_ONCE relies on the worker's existing global rate limiter
  // (10/s, shared across every tenant) — today's default behavior.
  // SPACED staggers each recipient's send by sendIntervalSeconds via a
  // per-job BullMQ delay, for large batches the owner wants paced out
  // rather than blasted.
  sendPacing          CampaignSendPacing @default(ALL_AT_ONCE)
  sendIntervalSeconds Int?

  metaTemplateId         String?
  metaTemplate           MetaTemplate? @relation(fields: [metaTemplateId], references: [id], onDelete: SetNull)
  // Campaign-wide values for the template's "custom" variable slots (e.g. a
  // discount %) — the same value for every recipient of this one send.
  // { [slotLabel]: value }
  templateVariableValues Json?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([tenantId])
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  contactId  String
  status     CampaignRecipientStatus @default(PENDING)
  sentAt     DateTime?
  updatedAt  DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

// ─── WhatsApp Meta-approved templates ───────────────────────────────────

// A template this tenant created (or synced) through the in-app builder,
// tracked against Meta's own Message Templates API — separate from
// wa-templates.ts, which is static starter copy with no connection to Meta
// at all. `status` deliberately stores whatever raw string Meta returns
// rather than a hardcoded enum, since Meta's real status vocabulary is
// richer than a simple APPROVED/REJECTED pair and can change server-side
// independent of anything this app does.
model MetaTemplate {
  id                String               @id @default(cuid())
  tenantId          String
  name              String
  category          MetaTemplateCategory @default(MARKETING)
  language          String
  status            String               @default("PENDING")
  rejectionReason   String?              @db.Text
  // Meta's own numeric template id, once known (from the create response or a status refresh).
  metaTemplateId    String?
  // The exact `components` array as submitted to Meta — source of truth for
  // the preview and for resolving variables at send time.
  components        Json
  headerType        String?
  // Our own S3 copy of a header image, reused as the `image.link` value at send time.
  headerMediaUrl    String?
  // Ordered [{ source: "guest_name" | "hotel_name" | "custom", label }] describing
  // each {{n}} placeholder in the body, in position order.
  bodyVariableSlots Json                 @default("[]")
  lastStatusCheckAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  followUpRules FollowUpRule[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}
