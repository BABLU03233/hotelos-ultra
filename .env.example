# ── Database ────────────────────────────────────────────────────────────
# Postgres with the pgvector extension. `docker-compose up -d postgres`
# gives you one locally on this exact connection string.
DATABASE_URL="postgresql://hotelos:hotelos@localhost:5432/hotelos_lite"

# ── Auth ────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=""
# Secret used to encrypt/decrypt per-tenant WhatsApp tokens at rest
# (AES-256-GCM, see src/lib/crypto.ts). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ── App ─────────────────────────────────────────────────────────────────
# Base URL this app is reachable at — used to build the WhatsApp webhook
# callback URL you paste into the Meta App dashboard.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────────
# These are the *defaults* used by the seed script for the first tenant
# (Hotel Ivory Towers). In production each tenant stores its own
# credentials in the database (Settings → WhatsApp), encrypted — these env
# vars exist only to bootstrap local dev / the seed tenant.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
# Any string you choose — must match what you enter in the Meta webhook
# verification screen.
WHATSAPP_VERIFY_TOKEN=""

# ── AI — Anthropic Claude (chat) ────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── AI — embeddings ──────────────────────────────────────────────────────
# Anthropic has no first-party embeddings endpoint, so RAG embeddings use
# Voyage AI (Anthropic's recommended embeddings partner) behind the same
# swappable AIProvider interface (src/lib/ai/embeddings.ts). Swap this file
# for a different provider later without touching callers.
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-3"

# ── Object storage (S3-compatible) ──────────────────────────────────────
# Works with AWS S3, Cloudflare R2, Supabase Storage, etc.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="hotelos-ultra"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# ── Background jobs ──────────────────────────────────────────────────────
# Redis for BullMQ (follow-up scheduler + campaign sender). Matches
# docker-compose's redis service by default.
REDIS_URL="redis://localhost:6379"

# ── Email (optional — stubbed for MVP) ──────────────────────────────────
SMTP_URL=""
